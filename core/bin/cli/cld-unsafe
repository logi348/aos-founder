#!/usr/bin/env bash
# cld-unsafe — `cld` with --dangerously-skip-permissions (hardened fork).
#
# Every tool call runs without asking. settings.json deny rules and the
# PreToolUse guard (core/hooks/guard_bash.py) still apply, but allow rules
# and the ~/.claude protection do not. Use it only when you are watching.
# Accepts everything `cld` accepts (prompt, --resume, --profile <name>).

printf '\n\033[1;33m!! cld-unsafe: permission checks are OFF for this session.\033[0m\n' >&2
printf '   Claude can run any command and edit any file without asking,\n' >&2
printf '   including its own settings. Deny rules and the AOS guard still apply.\n' >&2
printf '   Use plain `cld` unless you are actively supervising.\n\n' >&2

export AOS_CLD_UNSAFE=1
exec "$HOME/aos/core/bin/cli/cld" "$@"
